# --- Serveur ---
PORT=3000
HOST=0.0.0.0

# --- TikTok (OAuth officiel) ---
# https://developers.tiktok.com/ → votre app → Login Kit
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,follower.list

# --- Canal d'action (optionnel) ---
# L'API TikTok publique ne sait pas "retirer un follower".
# N'activez ceci que sur un canal que vous êtes en droit d'utiliser.
ACTION_GATEWAY_URL=
ACTION_GATEWAY_TOKEN=
